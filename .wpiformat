cppHeaderFileInclude {
	\.h$
	\.hpp$
	\.inc$
	\.inl$
}
cppSrcFileInclude {
	\.cpp$
}
modifiableFileExclude {
	src/main/include/LimelightHelpers.h$
	src/main/deploy/*
	src/stanbrairy/*
	src/test/*
	gradle/*
	.json$
}
licenseUpdateExclude {
	src/rebuilt/*
	src/main/include/Configs.h$
	src/main/include/ShooterLookupTable.h$
}
